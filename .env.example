# ==========================================
# Homeward Global Configuration
# ==========================================

# Database & Cache
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/homeward
REDIS_URL=redis://127.0.0.1:6379

# RPC Endpoints (Testnet: Arbitrum Sepolia acts as Nova & Arb One; Sepolia as L1)
NOVA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
L1_RPC_URL=https://rpc.sepolia.org
ARB_ONE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Contract Addresses (Deployed on Arbitrum Sepolia & Ethereum Sepolia)
NOVA_ENTRY_CONTRACT=0x0000000000000000000000000000000000000000
ETH_COMPLETION_ROUTER=0x0000000000000000000000000000000000000000
NOVA_OUTBOX_ADDRESS=0x0000000000000000000000000000000000000000
ARB_ONE_INBOX_ADDRESS=0x0000000000000000000000000000000000000000

# Worker Wallet (Private Key for advancing L1 Outbox claim & forwardJob)
WORKER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Gas & Polling Intervals
DISCOVERY_POLL_INTERVAL_MS=15000
MONITORING_POLL_INTERVAL_MS=30000
MAX_ALLOWED_L1_GAS_GWEI=50

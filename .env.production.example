# ==============================================================================
# Homeward — Production / Mainnet Configuration (.env.production.example)
# ==============================================================================
# Copy this file to .env.production and provide production credentials before
# deploying contracts or launching the production worker daemon.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPLOYER & WORKER WALLETS (Ethereum EOA)
# ------------------------------------------------------------------------------
# SECURITY CAUTION: The worker key should hold minimal funds needed for gas
# advance and should be stored in secure secrets management (e.g. AWS Secrets
# Manager, Vault, or secure server environment variables).
PRIVATE_KEY=
WORKER_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 2. CANONICAL MAINNET RPCs
# ------------------------------------------------------------------------------
# Arbitrum Nova (L2 Source Chain - Chain ID 42170)
NOVA_RPC_URL=https://nova.arbitrum.io/rpc

# Ethereum Mainnet (L1 Settlement & Router Chain - Chain ID 1)
# Note: Use a dedicated RPC provider (Alchemy, Infura, QuickNode) in high-throughput production
L1_RPC_URL=https://eth.llamarpc.com

# Arbitrum One (L2 Destination Chain - Chain ID 42161)
ARB_ONE_RPC_URL=https://arb1.arbitrum.io/rpc

# ------------------------------------------------------------------------------
# 3. CANONICAL MAINNET BRIDGE ADDRESSES ON ETHEREUM L1
# ------------------------------------------------------------------------------
# Official Arbitrum Nova Outbox on Ethereum Mainnet (Parent Chain ID 1)
# Used by EthCompletionRouter to authenticate L2ToL1 messages from Arbitrum Nova
NOVA_OUTBOX_ADDRESS=0xD4B80C3D7240325D18E645B49e6535A3Bf95cc58

# Official Arbitrum One Inbox on Ethereum Mainnet (Parent Chain ID 1)
# Used by EthCompletionRouter to dispatch canonical retryable tickets to Arbitrum One
ARB_ONE_INBOX_ADDRESS=0x4Dbd4fc535Ac27206064B68FfCf827b0A60BAB3f

# Canonical ArbSys Precompile (Universal on Arbitrum Nova & Arbitrum One)
ARB_SYS_ADDRESS=0x0000000000000000000000000000000000000064

# ------------------------------------------------------------------------------
# 4. DEPLOYED PRODUCTION CONTRACTS
# ------------------------------------------------------------------------------
# Auto-populated after running: npm run deploy:mainnet
NOVA_ENTRY_CONTRACT=
ETH_COMPLETION_ROUTER=

# ------------------------------------------------------------------------------
# 5. PRODUCTION DATABASE & REDIS
# ------------------------------------------------------------------------------
# PostgreSQL database with connection pooling for the worker and API
DATABASE_URL=postgres://homeward:your_secure_password@postgres:5432/homeward_production
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 6. WORKER GAS & POLLING CONFIGURATION
# ------------------------------------------------------------------------------
# Event discovery poll frequency on Nova (milliseconds)
DISCOVERY_POLL_INTERVAL_MS=15000

# Challenge-window monitoring poll frequency (milliseconds)
MONITORING_POLL_INTERVAL_MS=60000

# Strict worker safety cap: max base gas price on L1 (in Gwei) willing to pay
# If L1 base fee exceeds this threshold, worker will wait for gas to cool down
MAX_ALLOWED_L1_GAS_GWEI=40

# ------------------------------------------------------------------------------
# 7. BLOCK EXPLORER VERIFICATION KEYS
# ------------------------------------------------------------------------------
# Etherscan API Key for Ethereum Mainnet (Chain ID 1)
ETHERSCAN_API_KEY=

# Arbiscan API Key for Arbitrum One (Chain ID 42161)
ARBISCAN_API_KEY=

# Nova Arbiscan API Key for Arbitrum Nova (Chain ID 42170)
# (Often shares the same account / key family as Arbiscan)
NOVA_ARBISCAN_API_KEY=

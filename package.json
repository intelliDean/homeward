{
  "name": "homeward-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Homeward canonical ETH migration protocol from Arbitrum Nova to Arbitrum One",
  "scripts": {
    "deploy:testnet": "npx tsx scripts/deploy-testnet.ts",
    "deploy:mainnet": "npx tsx scripts/deploy-mainnet.ts",
    "migration:test": "npx tsx scripts/test-migration.ts",
    "worker:dev": "npm --prefix worker run dev",
    "worker:start": "npm --prefix worker start",
    "frontend:dev": "npm --prefix frontend run dev",
    "cli": "npx tsx cli/src/index.ts",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "test:contracts": "forge test --root contracts",
    "test:worker": "npm --prefix worker test",
    "test:fork": "forge test --root contracts --match-path 'test/fork/*' -vvv",
    "test": "forge test --root contracts && npm --prefix worker test",
    "slither": "cd contracts && slither ."
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
